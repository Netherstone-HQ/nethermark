{
  "name": "@netherstone/nethermark",
  "version": "0.1.2",
  "description": "A small Markdown source editor built on CodeMirror 6",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Netherstone-HQ/nethermark.git",
    "directory": "packages/nethermark"
  },
  "keywords": [
    "markdown",
    "editor",
    "codemirror"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./preview": {
      "types": "./dist/preview/index.d.ts",
      "default": "./dist/preview/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:browser": "playwright test",
    "icons": "node scripts/icons.mjs"
  },
  "peerDependencies": {
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language": "^6.13.0",
    "@codemirror/search": "^6.7.0",
    "@codemirror/state": "^6.7.0",
    "@codemirror/view": "^6.43.0",
    "@lezer/highlight": "^1.2.0",
    "@lezer/markdown": "^1.8.0"
  },
  "peerDependenciesMeta": {
    "@codemirror/search": {
      "optional": true
    }
  },
  "devDependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/common": "^1.5.4",
    "@lezer/highlight": "^1.2.5",
    "@lezer/markdown": "^1.8.1",
    "@phosphor-icons/core": "^2.1.1",
    "@playwright/test": "1.63.0",
    "@types/node": "^24.19.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
