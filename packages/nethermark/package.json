{
  "name": "@netherstone/nethermark",
  "version": "0.1.2",
  "description": "A small Markdown source editor built on CodeMirror 6",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Netherstone-HQ/nethermark.git",
    "directory": "packages/nethermark"
  },
  "keywords": [
    "markdown",
    "editor",
    "codemirror"
  ],
  "sideEffects": [
    "./dist/element/index.js",
    "./src/element/index.ts"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./preview": {
      "types": "./dist/preview/index.d.ts",
      "default": "./dist/preview/index.js"
    },
    "./element": {
      "types": "./dist/element/index.d.ts",
      "default": "./dist/element/index.js"
    },
    "./icons/regular": {
      "types": "./dist/icons/regular.d.ts",
      "default": "./dist/icons/regular.js"
    },
    "./icons/fill": {
      "types": "./dist/icons/fill.d.ts",
      "default": "./dist/icons/fill.js"
    },
    "./icons/bold": {
      "types": "./dist/icons/bold.d.ts",
      "default": "./dist/icons/bold.js"
    },
    "./icons/light": {
      "types": "./dist/icons/light.d.ts",
      "default": "./dist/icons/light.js"
    },
    "./icons/thin": {
      "types": "./dist/icons/thin.d.ts",
      "default": "./dist/icons/thin.js"
    }
  },
  "files": [
    "dist",
    "src",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:browser": "playwright test",
    "icons": "node scripts/icons.mjs"
  },
  "peerDependencies": {
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language": "^6.13.0",
    "@codemirror/search": "^6.7.0",
    "@codemirror/state": "^6.7.0",
    "@codemirror/view": "^6.43.0",
    "@lezer/highlight": "^1.2.0",
    "@lezer/markdown": "^1.8.0"
  },
  "peerDependenciesMeta": {
    "@codemirror/search": {
      "optional": true
    }
  },
  "devDependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/common": "^1.5.4",
    "@lezer/highlight": "^1.2.5",
    "@lezer/markdown": "^1.8.1",
    "@phosphor-icons/core": "^2.1.1",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
